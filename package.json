{
  "name": "codex-meter",
  "version": "0.1.0",
  "description": "Spend-aware Codex automation for open source maintainers: policy gates, budget enforcement, an audit ledger, and PR spend reports.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "codex-meter": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "schemas",
    "action.yml",
    "README.md",
    "README.ko.md"
  ],
  "keywords": [
    "codex",
    "openai",
    "code-review",
    "budget",
    "maintainer",
    "github-action",
    "ci"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "explain": "node dist/src/cli.js explain",
    "report": "node dist/src/cli.js report"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "yaml": "^2.9.1"
  }
}
